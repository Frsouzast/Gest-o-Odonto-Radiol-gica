{
  "name": "precificacao-clinica",
  "version": "1.0.0",
  "description": "Calculadora de custo e precificação para clínicas de radiologia odontológica",
  "main": "electron/main.js",
  "scripts": {
    "test": "node --test server/*.test.js",
    "build:frontend": "node frontend/build.js",
    "start": "npm run build:frontend && electron .",
    "dist": "npm run build:frontend && electron-builder --win"
  },
  "build": {
    "appId": "com.precificacaoclinica.app",
    "productName": "Precificação Clínica",
    "files": [
      "electron/**/*",
      "server/**/*",
      "frontend/dist/**/*",
      "node_modules/**/*",
      "package.json",
      "!server/*.test.js"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/*.wasm"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "PrecificacaoClinica-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.40.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3"
  }
}
