# Database configuration
DATABASE_URL="file:./local.db"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# Chave estável para pseudonimizar contadores de acesso (mínimo 32 caracteres aleatórios)
AUTH_SECRET=""
APP_ORIGIN="http://localhost:3000"

# Application Environment
NODE_ENV="development"

# Obrigatório em produção; nunca usar credencial de leitura apenas
AUTH_RATE_LIMIT_REDIS_URL=""
AUTH_RATE_LIMIT_REDIS_TOKEN=""
# Só habilitar atrás de proxy verificado que sobrescreve X-Real-IP
AUTH_RATE_LIMIT_TRUST_PROXY="false"

# Chave própria de 32 bytes aleatórios em hexadecimal; guardar fora dos backups
BACKUP_ENCRYPTION_KEY=""
BACKUP_DIRECTORY="backup"
